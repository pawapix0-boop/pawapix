# Admin credentials
NODE_ENV=production
CLIENT_URL=https://your-domain.example
ADMIN_EMAIL=admin@pawapix.com
ADMIN_PASSWORD=change-this-password
SPECIAL_ADMIN_EMAIL=special-admin@pawapix.com
SPECIAL_ADMIN_PASSWORD=change-this-special-password
ADMIN_TOKEN_SECRET=generate-a-long-random-secret

# Server port (most hosts inject PORT automatically)
# PORT=4000

# Optional SMTP email delivery
# EMAIL_FROM=no-reply@your-domain.example
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password

# Payment checkout URLs
# Prefer environment secrets for payment API access.
# PAYSTACK_SECRET_KEY=sk_live_your-secret-key
# Set each enabled gateway to a real hosted checkout URL or payment link.
# Do not use the provider home page URL.
# PAYSTACK_SECRET_KEY=sk_live_your-secret-key
# STRIPE_CHECKOUT_URL=https://buy.stripe.com/your-payment-link
# PAYPAL_CHECKOUT_URL=https://www.paypal.com/checkoutnow?token=your-token
# PAYSTACK_CHECKOUT_URL=https://paystack.com/pay/your-payment-link
# FLUTTERWAVE_CHECKOUT_URL=https://checkout.flutterwave.com/your-payment-link
