# Copy to .env and fill in the SMTP credentials for real email delivery.
EMAIL_FROM=pawapixsupport@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=pawapixsupport@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_CONNECTION_TIMEOUT=5000
SMTP_GREETING_TIMEOUT=5000
SMTP_SOCKET_TIMEOUT=10000
SMTP_MAX_CONNECTIONS=2
SMTP_MAX_MESSAGES=100
CLIENT_URL=https://your-domain.com
# Required in production. Use long, unique values and never commit real secrets.
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_TOKEN_SECRET=replace-with-a-long-random-token-secret
SPECIAL_ADMIN_PASSWORD=replace-with-a-second-strong-admin-password
# Prefer protected environment secrets for payment API access.
# PAYSTACK_SECRET_KEY=sk_live_your-secret-key
# Optional hosted checkout URLs for gateways without server-side initialization.
# Use real payment links, never provider home pages.
# STRIPE_CHECKOUT_URL=https://buy.stripe.com/your-payment-link
# PAYPAL_CHECKOUT_URL=https://www.paypal.com/checkoutnow?token=your-token
# PAYSTACK_CHECKOUT_URL=https://paystack.com/pay/your-payment-link
# FLUTTERWAVE_CHECKOUT_URL=https://checkout.flutterwave.com/your-payment-link
